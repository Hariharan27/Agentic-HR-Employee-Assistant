ENVIRONMENT=development
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql+psycopg://hr_app:hr_app@postgres:5432/hr_assistant
POSTGRES_DB=hr_assistant
POSTGRES_USER=hr_app
POSTGRES_PASSWORD=hr_app
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=hr_policies
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
POLICY_DOCS_DIR=policy_docs
RAG_COLLECTION_VECTOR_SIZE=384
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=250
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.45
LLM_PROVIDER=bedrock-mantle
BEDROCK_REGION=us-east-1
BEDROCK_API_KEY=
BEDROCK_OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
ROUTER_MODEL_ID=openai.gpt-oss-20b
STANDARD_MODEL_ID=openai.gpt-oss-120b
COMPLEX_MODEL_ID=openai.gpt-oss-120b
ROUTER_REASONING_EFFORT=low
COMPLEX_REASONING_EFFORT=medium
ROUTER_MAX_OUTPUT_TOKENS=250
STANDARD_MAX_OUTPUT_TOKENS=700
COMPLEX_MAX_OUTPUT_TOKENS=1200
COMPLEX_ESCALATION_THRESHOLD=0.70
LLM_MAX_RETRIES=1
LLM_MAX_CALLS_PER_REQUEST=8
# Leave Agent: switch to native tool calling only after `python -m app.llm.probe` passes.
LEAVE_AGENT_NATIVE_TOOLS=false
LEAVE_AGENT_MAX_REPAIRS=1
PARKING_BOOKING_HORIZON_DAYS=30
PARKING_CANCELLATION_CUTOFF_HOUR=20
PARKING_CHECK_IN_OPEN_HOUR=7
PARKING_ARRIVAL_CUTOFF_HOUR=11
PARKING_NO_SHOW_GRACE_MINUTES=15
PARKING_NO_SHOW_LOOKBACK_DAYS=30
PARKING_NO_SHOW_STRIKE_LIMIT=3
PARKING_SUSPENSION_DAYS=14
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
