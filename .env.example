ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hr_app:hr_app@postgres:5432/hr_assistant
POSTGRES_DB=hr_assistant
POSTGRES_USER=hr_app
POSTGRES_PASSWORD=hr_app
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=hr_policies
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
POLICY_DOCS_DIR=policy_docs
RAG_COLLECTION_VECTOR_SIZE=384
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=250
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.45
LLM_PROVIDER=bedrock-mantle
BEDROCK_REGION=us-east-1
BEDROCK_API_KEY=
BEDROCK_OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_ANTHROPIC_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
ROUTER_MODEL_ID=openai.gpt-oss-20b
STANDARD_MODEL_ID=openai.gpt-oss-120b
COMPLEX_MODEL_ID=anthropic.claude-haiku-4-5
ROUTER_MAX_OUTPUT_TOKENS=250
STANDARD_MAX_OUTPUT_TOKENS=700
COMPLEX_MAX_OUTPUT_TOKENS=900
COMPLEX_ESCALATION_THRESHOLD=0.70
LLM_MAX_RETRIES=1
LLM_MAX_CALLS_PER_REQUEST=3
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
